{
  "name": "upsa-scraper",
  "version": "1.0.0",
  "type": "module",
  "description": "Scrapes UPSA website for announcements, hostel notices, and fee deadlines. Sends push notification reminders via Expo.",
  "scripts": {
    "sync:posts": "node src/cli.js posts",
    "sync:events": "node src/cli.js events",
    "sync:fees": "node src/cli.js fees",
    "dry-run:posts": "node src/cli.js posts --dry-run",
    "dry-run:events": "node src/cli.js events --dry-run",
    "dry-run:fees": "node src/cli.js fees --dry-run",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
